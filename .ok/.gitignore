# .ok/local/ holds per-machine runtime state. Anything inside is
# machine-local and never committed.
local/

# git worktrees created from the desktop worktree selector
worktrees/

# Machine-local directories left behind by older projects.
cache/
tmp/

# Per-machine runtime state at the .ok/ root.
principal.json
state.json
server.lock
ui.lock
sync-state.json
conflicts.json
last-spawn-error.log
