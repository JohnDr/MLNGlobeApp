+void MapQuickItem::setSkyEnabled(bool enabled) {
+    Q_D(MapQuickItem);
+
+    d->m_skyExplicit = true; // once set, false means no sky (not "leave the style's sky alone")
+    if (d->m_skyEnabled == enabled) {
